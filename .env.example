# رابط ومفتاح مشروع Supabase الخاص بك (Publishable Key فقط)
# احصل عليها من: Supabase Dashboard > Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# ملاحظة: لا يستخدم هذا المشروع Secret Key أو Service Role Key إطلاقًا.
# جميع العمليات تتم عبر Publishable Key فقط مع سياسات RLS في قاعدة البيانات.

# اسم التطبيق
NEXT_PUBLIC_APP_NAME="الهرم ترافيل"
